<?xml version="1.0" encoding="utf-8"?>
<!-- 间距 / 字号 / 颜色统一走设计系统 token（见 dimens.xml、themes.xml） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_16">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textAppearance="@style/TextAppearance.App.Headline"
        android:gravity="center"
        android:layout_marginBottom="@dimen/spacing_24"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_ui_scaling"
        android:textAppearance="@style/TextAppearance.App.Section"
        android:layout_marginBottom="@dimen/spacing_8"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_ui_scaling_description"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="@dimen/spacing_16"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/spacing_8">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_current_scale"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <TextView
            android:id="@+id/text_scale_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scale_1_0"
            android:textAppearance="@style/TextAppearance.App.Section"
            android:textColor="?attr/colorPrimary"
            android:layout_marginStart="@dimen/spacing_8"/>

    </LinearLayout>

    <SeekBar
        android:id="@+id/seekbar_ui_scale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:layout_marginBottom="@dimen/spacing_8"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_24">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:text="@string/settings_size_small"
            android:textAppearance="@style/TextAppearance.App.Label" />

        <TextView
            android:id="@+id/text_default_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_size_default"
            android:textAppearance="@style/TextAppearance.App.Label" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:text="@string/settings_size_large"
            android:textAppearance="@style/TextAppearance.App.Label" />

    </FrameLayout>

    <Button
        android:id="@+id/btn_apply_scale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_apply_settings"
        android:layout_marginBottom="@dimen/spacing_8"/>

    <Button
        android:id="@+id/btn_reset_scale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_reset_to_default"
        android:layout_marginBottom="@dimen/spacing_24"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_theme"
        android:textAppearance="@style/TextAppearance.App.Section"
        android:layout_marginBottom="@dimen/spacing_8"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_theme_description"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="@dimen/spacing_16"/>

    <RadioGroup
        android:id="@+id/radiogroup_theme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_24">

        <RadioButton
            android:id="@+id/radio_theme_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_theme_light"
            android:layout_marginBottom="@dimen/spacing_8"/>

        <RadioButton
            android:id="@+id/radio_theme_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_theme_dark"
            android:layout_marginBottom="@dimen/spacing_8"/>

        <RadioButton
            android:id="@+id/radio_theme_system"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_theme_system"/>

    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/general_tips"
        android:textAppearance="@style/TextAppearance.App.Title"
        android:layout_marginBottom="@dimen/spacing_8"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_tips_content"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="?attr/colorOnSurfaceVariant"/>

</LinearLayout>
</ScrollView>
