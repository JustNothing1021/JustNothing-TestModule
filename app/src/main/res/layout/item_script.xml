<?xml version="1.0" encoding="utf-8"?>
<!--
  脚本列表的一项。原来根布局铺了一层 background="#FFFFFF"、分类那一行铺了一层 background="#F0F0F0"，
  颜色被 token 化时当成「硬编码浅色底」整行删掉了，结果两项之间的边界和分类色块一起消失。

  教训：删背景之前要看它是不是在承担**结构**。这里的两层浅色不是装饰，是在表达
  「一项的范围」和「分类这一行的范围」。所以正确做法不是删掉，而是换成主题的面板角色，
  并按原样保留层级：外层一项用 container，内层分类色块用 containerHighest（再高一级）。
  浅色下越高越暗、深色下越高越亮，两边都是「色块压在一项上面」。

  layout_marginBottom 是新加的：只给背景不加间距的话，相邻两项的颜色会连成一片，
  反而比没有背景更像一块整体。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_12"
    android:layout_marginBottom="@dimen/spacing_8"
    android:background="?attr/colorSurfaceContainer">

    <TextView
        android:id="@+id/text_script_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.App.Title"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/text_script_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/text_script_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:padding="@dimen/spacing_4"
        android:background="?attr/colorSurfaceContainerHighest" />

    <TextView
        android:id="@+id/text_script_commands"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:maxLines="3"
        android:ellipsize="end" />

</LinearLayout>
